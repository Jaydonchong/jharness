POSTGRES_DB=ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MEMORY_FOLDER_FS_PATH=/absolute/path/to/jharness/memory
SESSION_LOG_FS_PATH=/absolute/path/to/jharness/session-logs
GOOGLE_GCAL_CREDENTIALS_PATH=/absolute/path/to/google-service-account.json
OTEL_SERVICE_NAME=jharness
SERVICE_NAMESPACE=jharness
ENVIRONMENT_NAME=local
APP_VERSION=1.0.0
TEMPO_QUERY_URL=http://tempo:3200
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OLLAMA_BASE_URL=http://localhost:11434
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_WEBHOOK_URL=
# Allowlist and route messages by Discord channel name, case-insensitively.
DISCORD_ACCOUNT_ID=
DISCORD_PRODUCTIVITY_CHANNEL_NAME=
DISCORD_SYSTEM_DESIGN_CHANNEL_NAME=
# Optional Wyd task access. The agent can only read or update tasks in these folders.
# WYD_API_BASE_URL is the server origin, without /api/v1.
WYD_API_BASE_URL=wyd-jaydon.duckdns.org
WYD_API_TOKEN=
WYD_ALLOWED_FOLDER_IDS=
