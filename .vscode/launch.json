{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug npm start",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeVersion": "22.23.3",
            "runtimeArgs": ["start"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true,
            "sourceMaps": true,
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
