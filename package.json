{
	"name": "jharness",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"build": "tsc && tsc-alias",
		"start": "npm run build && node --require ./dist/telemetry/instrumentation.js --env-file=.env dist/index.js",
		"rag:index": "npm run build && node --env-file=.env dist/scripts/RAGIndexing.js",
		"migration:generate": "npm run build && node --env-file=.env ./node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
		"migration:run": "npm run build && node --env-file=.env ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
		"migration:revert": "npm run build && node --env-file=.env ./node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
		"prepare": "node scripts/install-husky.mjs",
		"prettify": "prettier . --write",
		"evaluation:run": "npm run build && node --env-file-if-exists=.env dist/scripts/RunEvaluationSuites.js"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": "prettier --write"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@openserp/sdk": "0.2.9",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/auto-instrumentations-node": "^0.83.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.301.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.301.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.301.0",
		"@opentelemetry/resources": "^3.1.0",
		"@opentelemetry/sdk-logs": "^3.1.0",
		"@opentelemetry/sdk-metrics": "^3.1.0",
		"@opentelemetry/sdk-node": "^0.301.0",
		"@opentelemetry/sdk-trace": "^3.1.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.4",
		"ai": "^7.0.127",
		"axios": "^1.20.0",
		"discord.js": "^14.27.0",
		"google-auth-library": "^11.1.0",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"typeorm": "^1.1.2",
		"typescript": "^7.0.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"tsc-alias": "^1.9.10"
	}
}
