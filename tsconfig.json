{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "sourceMap": true,
    "rootDir": "src",
    "paths": {
      "@agent/*": ["./src/agent/*"],
      "@compaction/*": ["./src/compaction/*"],
      "@database/*": ["./src/database/*"],
      "@evaluation/*": ["./src/evaluation/*"],
      "@harness/*": ["./src/harness/*"],
      "@memory/*": ["./src/memory/*"],
      "@migrations/*": ["./src/migrations/*"],
      "@network/*": ["./src/network/*"],
      "@providers/*": ["./src/providers/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@service/*": ["./src/service/*"],
      "@telemetry/*": ["./src/telemetry/*"],
      "@tools/*": ["./src/tools/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
